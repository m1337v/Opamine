{
  "schema": "rhinject.systemhook.ownership.v1",
  "scope": "BaseBin/systemhook plus its launchd handoff",
  "modes": [
    {
      "name": "stock",
      "mode_source": "common.c:root_hide_injection_mode",
      "spawn_behavior": "default RootHide spawn configuration unless legacy control files select another mode",
      "hidden_hider": false,
      "hidden_tweak_loading": false
    },
    {
      "name": "blacklist",
      "mode_source": "common.c:root_hide_injection_mode",
      "spawn_behavior": "inject/trust by default, with explicit uninject and stability exceptions",
      "hidden_hider": false,
      "hidden_tweak_loading": false
    },
    {
      "name": "whitelist",
      "mode_source": "common.c:root_hide_injection_mode",
      "spawn_behavior": "inject/trust only for executable or system allowlist matches",
      "hidden_hider": false,
      "hidden_tweak_loading": false
    },
    {
      "name": "hiddenwhitelist",
      "mode_source": "common.c:root_hide_injection_mode",
      "spawn_behavior": "blacklist-equivalent baseline; launchd may add explicit hidden injection and selected tweaks",
      "hidden_hider": "when ROOTHIDE_HIDDEN_INJECTION=1 reaches systemhook",
      "hidden_tweak_loading": "when ROOTHIDE_ENABLE_HIDDEN_TWEAKS=1 reaches systemhook"
    },
    {
      "name": "blacklistallowlist",
      "mode_source": "common.c:root_hide_injection_mode",
      "spawn_behavior": "blacklist-equivalent baseline with selected hidden allowlist path",
      "hidden_hider": "when ROOTHIDE_HIDDEN_INJECTION=1 reaches systemhook",
      "hidden_tweak_loading": "minimal selected-tweak path when ROOTHIDE_ENABLE_HIDDEN_TWEAKS=1"
    }
  ],
  "owners": [
    {
      "id": "mode-resolution",
      "owner": "BaseBin/systemhook/src/common.c",
      "phase": "pre-spawn and runtime mode lookup",
      "symbols": [
        "root_hide_injection_mode",
        "root_hide_injection_mode_is_hidden_whitelist",
        "root_hide_injection_mode_is_blacklist_allowlist",
        "root_hide_injection_mode_uses_whitelist_rules",
        "spawn_config_for_executable"
      ],
      "surfaces": ["mode plist", "legacy marker fallback", "spawn inject/trust"]
    },
    {
      "id": "launchd-mode-handoff",
      "owner": "BaseBin/launchdhook/src/roothider.m",
      "phase": "launchd spawn decision",
      "symbols": [
        "RootHideApplyHiddenWhitelistTweakEnvironment",
        "RootHideShouldEnableHiddenWhitelistBootstrap",
        "RootHideIsAppWhitelisted"
      ],
      "surfaces": ["per-app mode", "selected tweak list", "hider profile", "disabled hider hooks"]
    },
    {
      "id": "systemhook-entry-and-child-bridge",
      "owner": "BaseBin/systemhook/src/main.c",
      "phase": "constructor and process handoff",
      "symbols": [
