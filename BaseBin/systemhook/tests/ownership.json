    },
    {
      "id": "syscall-shim",
      "owner": "BaseBin/systemhook/src/roothider_common.c",
      "phase": "low-level RootHide compatibility",
      "symbols": [
        "__sysctl_hook",
        "__sysctlbyname_hook"
      ],
      "surfaces": ["direct syscall-backed sysctl", "AMFI query compatibility"]
    },
    {
      "id": "selected-tweak-loader",
      "owner": "BaseBin/systemhook/src/roothider_main.c",
      "phase": "late runtime after RootHide check-in",
      "symbols": [
        "roothide_hidden_tweak_prepare_for_loader",
        "roothide_hidden_tweak_prepare_minimal_runtime",
        "roothide_hidden_tweak_load_selected"
      ],
      "surfaces": ["dependency ordering", "trust", "dlopen", "selected tweak handles"]
    }
  ],
  "invariants": [
    "Only a verified active hook may be advertised by dlsym remapping.",
    "A true MH_EXECUTE image must be selected even when dyld image zero is a dylib.",
    "A hidden DIR close must unregister state before the DIR pointer can be reused.",
    "A sysctlbyname size query must preserve the platform two-pass contract.",
    "All five injection modes must remain distinct at the launchd/systemhook boundary."
  ]
}
