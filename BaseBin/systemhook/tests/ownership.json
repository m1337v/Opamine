      "owner": "BaseBin/systemhook/src/hider_identity.c",
      "phase": "core systemhook initialization",
      "symbols": [
        "rhi_hider_identity_init",
        "rhi_hider_identity_executable_path",
        "rhi_hider_identity_executable_header",
        "rhi_hider_identity_image_text_range",
        "rhi_hider_identity_executable_ranges"
